{
  "name": "ocs-chat",
  "private": true,
  "version": "1.6.8",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:uat": "vite --mode uat",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "build:uat": "vue-tsc --noEmit && vite build --mode uat",
    "domains:snapshot": "node ./scripts/prefetch-domain-snapshot.mjs --mode production",
    "domains:snapshot:test": "node ./scripts/prefetch-domain-snapshot.mjs --mode test",
    "domains:snapshot:uat": "node ./scripts/prefetch-domain-snapshot.mjs --mode uat",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:domains": "node ./scripts/run-tauri-dev.mjs --domains",
    "tauri:dev:domains:uat": "node ./scripts/run-tauri-dev.mjs --domains -- --mode uat",
    "tauri:dev:uat": "tauri dev -- --mode uat",
    "tauri:dev:mac-app": "tauri build --debug --bundles app && open 'src-tauri/target/debug/bundle/macos/OCS Chat.app'",
    "tauri:build": "tauri build",
    "tauri:build:mac": "TAURI_TARGET=universal-apple-darwin bash ./scripts/build-release-dist-macos.sh",
    "tauri:build:mac:uat": "tauri build --target universal-apple-darwin -- --mode uat",
    "tauri:build:win": "bash ./scripts/tauri-build-win.sh",
    "tauri:build:win:uat": "bash ./scripts/tauri-build-win.sh -- --mode uat",
    "release:mac": "bash ./release-mac.sh",
    "release:dist:mac": "env -u TAURI_TARGET bash ./scripts/build-release-dist-macos.sh",
    "release:dist:mac:test": "bash ./scripts/release-dist-mac-by-env.sh test",
    "release:dist:mac:uat": "bash ./scripts/release-dist-mac-by-env.sh uat",
    "release:dist:mac:prod": "bash ./scripts/release-dist-mac-by-env.sh prod",
    "release:dist:mac:universal": "TAURI_TARGET=universal-apple-darwin bash ./scripts/build-release-dist-macos.sh",
    "release:dist:mac:45": "bash ./scripts/build-release-brand.sh 45 mac",
    "release:dist:mac:55": "bash ./scripts/build-release-brand.sh 55 mac",
    "release:dist:mac:97": "bash ./scripts/build-release-brand.sh 97 mac",
    "release:dist:mac:all-icons": "bash ./scripts/build-release-brand.sh all mac",
    "release:dist:mac:pkgs": "bash ./scripts/build-release-mac-pkgs.sh",
    "release:dist:win": "bash ./scripts/build-release-dist-windows.sh",
    "release:dist:win:test": "bash ./scripts/release-dist-win-by-env.sh test",
    "release:dist:win:uat": "bash ./scripts/release-dist-win-by-env.sh uat",
    "release:dist:win:prod": "bash ./scripts/release-dist-win-by-env.sh prod",
    "release:dist:win:45": "bash ./scripts/build-release-brand.sh 45 win",
    "release:dist:win:55": "bash ./scripts/build-release-brand.sh 55 win",
    "release:dist:win:97": "bash ./scripts/build-release-brand.sh 97 win",
    "release:dist:win:all-icons": "bash ./scripts/build-release-brand.sh all win",
    "release:dist:win:installers": "bash ./scripts/build-release-win-installers.sh",
    "proto:gen": "pbjs -t static-module --es6 -w es6 -o src/proto/generated.js proto/common.proto proto/web.proto && pbts -o src/proto/generated.d.ts src/proto/generated.js",
    "lint": "eslint src --ext .ts,.vue --fix",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-deep-link": "2.4.7",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@js-preview/docx": "^1.6.4",
    "@js-preview/excel": "^1.7.14",
    "@js-preview/pdf": "^2.0.10",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.0.9",
    "mitt": "^3.0.1",
    "pako": "^2.1.0",
    "pinia": "^2.1.7",
    "protobufjs": "^7.2.6",
    "qrcode.vue": "^3.8.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/pako": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "protobufjs-cli": "^2.0.0",
    "sass": "^1.72.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.7"
  }
}
