{
  "name": "ocs-chat",
  "private": true,
  "version": "1.6.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:uat": "vite --mode uat",
    "build": "vue-tsc --noEmit && vite build",
    "build:uat": "vue-tsc --noEmit && vite build --mode uat",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:uat": "tauri dev -- --mode uat",
    "tauri:dev:mac-app": "tauri build --debug --bundles app && open 'src-tauri/target/debug/bundle/macos/OCS Chat.app'",
    "tauri:build": "tauri build",
    "tauri:build:mac": "TAURI_TARGET=universal-apple-darwin bash ./scripts/build-release-dist-macos.sh",
    "tauri:build:mac:uat": "tauri build --target universal-apple-darwin -- --mode uat",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:win:uat": "tauri build --target x86_64-pc-windows-msvc -- --mode uat",
    "release:mac": "bash ./release-mac.sh",
    "release:dist:mac": "env -u TAURI_TARGET bash ./scripts/build-release-dist-macos.sh",
    "release:dist:mac:universal": "TAURI_TARGET=universal-apple-darwin bash ./scripts/build-release-dist-macos.sh",
    "release:dist:win": "bash ./scripts/build-release-dist-windows.sh",
    "proto:gen": "pbjs -t static-module --es6 -w es6 -o src/proto/generated.js proto/common.proto proto/web.proto && pbts -o src/proto/generated.d.ts src/proto/generated.js",
    "lint": "eslint src --ext .ts,.vue --fix",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.0.9",
    "mitt": "^3.0.1",
    "pako": "^2.1.0",
    "pinia": "^2.1.7",
    "protobufjs": "^7.2.6",
    "qrcode.vue": "^3.8.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/pako": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "protobufjs-cli": "^2.0.0",
    "sass": "^1.72.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.7"
  }
}
