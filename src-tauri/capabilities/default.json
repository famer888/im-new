{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability",
  "windows": ["main", "login", "chat_*", "notification_*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-save"
  ]
}
