{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCS Chat",
  "version": "1.7.2",
  "identifier": "cn.97.chat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash ./scripts/run-tauri-before-build.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": [
        "script-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob: asset: http://asset.localhost; media-src 'self' https: http: data: blob: asset: http://asset.localhost; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: wss: ws: https: http: blob: asset: http://asset.localhost; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "entitlements": "entitlements.mac.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wfc"]
      }
    },
    "shell": {
      "open": "(https?://.*)|((/|[A-Za-z]:\\\\\\\\).*(/|\\\\\\\\)(image-cache|video-cache)((/|\\\\\\\\).*)?)"
    }
  }
}
