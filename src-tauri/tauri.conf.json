{
  "$schema": "https://raw.githubusercontent.com/nicotinamide/tauri/refs/heads/v2/tooling/cli/schema.json",
  "productName": "OCS Chat",
  "version": "1.6.8",
  "identifier": "cn.97.chat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": [
        "script-src"
      ],
      "csp": "default-src 'self'; img-src 'self' https: http: data:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: ws: https: http:; worker-src 'self' blob:"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wfc"]
      }
    },
    "shell": {
      "open": "(https?://.*)|((/|[A-Za-z]:\\\\\\\\).*(/|\\\\\\\\)image-cache((/|\\\\\\\\).*)?)"
    },
    "updater": {
      "endpoints": [
        "https://your-server.com/api/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  }
}
